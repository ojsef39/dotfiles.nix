{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>JHOFER-Cloud/renovate-presets//default"],
  "nix": {
    "enabled": true
  },
  "schedule": ["at any time"],
  "automerge": true,
  "automergeType": "pr",
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "matchDepNames": ["nixpkgs-copilot-cli"],
      "enabled": false
    }
  ]
}
